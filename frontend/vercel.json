{
  "rewrites": [
    {
      "source": "/((?!assets/|sw\\.js|manifest\\.webmanifest|favicon\\.svg|pwa-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
