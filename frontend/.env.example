# URL cascade: TUNNEL → LOCAL (if VITE_APP_ENV=local) → PROD → legacy VITE_API_URL
# Leave VITE_APP_ENV empty for prod. Put VITE_APP_ENV=local in gitignored .env.local for local API.
VITE_APP_ENV=
VITE_API_URL_PROD=https://lekha-likhi-api.onrender.com
VITE_API_URL_LOCAL=http://localhost:8000
VITE_API_URL_TUNNEL=

# Legacy fallback (kept for compatibility; cascade keys win)
VITE_API_URL=http://localhost:8000
