# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Upstash Redis
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL cascade: TUNNEL → LOCAL (if APP_ENV=local) → PROD → legacy FRONTEND_URL
# Leave APP_ENV empty for prod. Put APP_ENV=local in gitignored .env.local for local UI.
APP_ENV=
FRONTEND_URL_PROD=https://lekha-likhi.vercel.app
FRONTEND_URL_LOCAL=http://localhost:5173
FRONTEND_URL_TUNNEL=

# Legacy fallback (kept for compatibility; cascade keys win)
FRONTEND_URL=http://localhost:5173

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects POST /push/dispatch-reminders (X-Cron-Secret header)
CRON_SECRET=change-me-to-a-long-random-string
